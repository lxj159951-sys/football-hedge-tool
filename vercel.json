{
  "version": 2,
  "builds": [
    {
      "src": "api/proxy.js",
      "functions": {
        "api/**": {
          "runtime": "@vercel/node"
        }
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
